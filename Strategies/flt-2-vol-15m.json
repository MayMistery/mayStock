{
  "schema": 1,
  "id": "flt-2-vol-15m",
  "name": "F2' 高波动过滤 · 15m",
  "notes": "和 F2 同一套信号与过滤器，只换 K 线周期。用来测「每笔毛边际 ∝ √持仓时长」这条标度律 —— 它决定了这一族在多高的频率上还可能有钱赚。",
  "market": {
    "instId": "BTC-USDT-SWAP",
    "instType": "SWAP",
    "bar": "15m"
  },
  "params": [
    {
      "name": "lb",
      "default": 12,
      "min": 6,
      "max": 60
    },
    {
      "name": "k",
      "default": 1.5,
      "min": 1,
      "max": 3
    },
    {
      "name": "volLb",
      "default": 96,
      "min": 24,
      "max": 500
    },
    {
      "name": "volMult",
      "default": 1.3,
      "min": 0.8,
      "max": 3
    }
  ],
  "signals": {
    "longEntry": "close < bb_lower(close, lb, k) and natr(14) > sma(natr(14), volLb) * volMult",
    "longExit": "close > sma(close, lb)",
    "shortEntry": "close > bb_upper(close, lb, k) and natr(14) > sma(natr(14), volLb) * volMult",
    "shortExit": "close < sma(close, lb)"
  },
  "sizing": {
    "mode": "equityPct",
    "value": 100
  },
  "risk": {
    "leverage": 1,
    "maxDailyLossPct": 6,
    "maxHoldBars": 36
  }
}