{
  "schema": 1,
  "id": "vol-a-squeeze-break-mk",
  "name": "A 布林挤压突破 · 1H",
  "notes": "波动率压缩后突破。只在区间扩张时交易。",
  "market": {
    "instId": "BTC-USDT-SWAP",
    "instType": "SWAP",
    "bar": "1H"
  },
  "params": [
    {
      "name": "bbn",
      "default": 20,
      "min": 10,
      "max": 60
    },
    {
      "name": "wn",
      "default": 120,
      "min": 40,
      "max": 400
    },
    {
      "name": "sq",
      "default": 0.8,
      "min": 0.4,
      "max": 1.0
    },
    {
      "name": "brk",
      "default": 12,
      "min": 4,
      "max": 48
    },
    {
      "name": "exn",
      "default": 8,
      "min": 3,
      "max": 30
    }
  ],
  "signals": {
    "longEntry": "ref(bb_width(close, bbn, 2), 1) < sq * sma(bb_width(close, bbn, 2), wn) and close > ref(highest(high, brk), 1)",
    "longExit": "close < ref(lowest(low, exn), 1)",
    "shortEntry": "ref(bb_width(close, bbn, 2), 1) < sq * sma(bb_width(close, bbn, 2), wn) and close < ref(lowest(low, brk), 1)",
    "shortExit": "close > ref(highest(high, exn), 1)"
  },
  "sizing": {
    "mode": "equityPct",
    "value": 100
  },
  "risk": {
    "leverage": 1,
    "maxDailyLossPct": 6,
    "maxHoldBars": 48,
    "cooldownBars": 0
  },
  "costs": {
    "feeBps": 2,
    "slippageBps": 0
  }
}