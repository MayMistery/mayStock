{
  "schema": 1,
  "id": "flt-1-range-reversion",
  "name": "F1 区间过滤 · 快速回复",
  "notes": "基线回复信号，只在慢趋势走平时开仓。过滤器：|12h 涨跌幅| 小于阈值，即没有单边行情。假设：均值回复的边际在趋势里被吃掉，去掉趋势段能抬高每笔期望。",
  "market": {
    "instId": "BTC-USDT-SWAP",
    "instType": "SWAP",
    "bar": "5m"
  },
  "params": [
    {
      "name": "lb",
      "default": 12,
      "min": 6,
      "max": 60
    },
    {
      "name": "k",
      "default": 1.5,
      "min": 1,
      "max": 3
    },
    {
      "name": "trendN",
      "default": 144,
      "min": 48,
      "max": 576
    },
    {
      "name": "flat",
      "default": 1.0,
      "min": 0.2,
      "max": 4
    }
  ],
  "signals": {
    "longEntry": "close < bb_lower(close, lb, k) and abs(roc(close, trendN)) < flat",
    "longExit": "close > sma(close, lb)",
    "shortEntry": "close > bb_upper(close, lb, k) and abs(roc(close, trendN)) < flat",
    "shortExit": "close < sma(close, lb)"
  },
  "sizing": {
    "mode": "equityPct",
    "value": 100
  },
  "risk": {
    "leverage": 1,
    "maxDailyLossPct": 6,
    "maxHoldBars": 36
  }
}