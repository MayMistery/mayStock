{
  "schema": 1,
  "id": "flt-2-volburst-reversion",
  "name": "F2 高波动过滤 · 快速回复",
  "notes": "同一回复信号，只在波动率高于自身均值时开仓。假设：回复幅度按波动率缩放，所以每笔毛边际（bps）在高波动段更大，而成本是固定的 bps —— 这是唯一能真正改变成本比的过滤方向。",
  "market": {
    "instId": "BTC-USDT-SWAP",
    "instType": "SWAP",
    "bar": "5m"
  },
  "params": [
    {
      "name": "lb",
      "default": 12,
      "min": 6,
      "max": 60
    },
    {
      "name": "k",
      "default": 1.5,
      "min": 1,
      "max": 3
    },
    {
      "name": "volLb",
      "default": 288,
      "min": 48,
      "max": 1000
    },
    {
      "name": "volMult",
      "default": 1.3,
      "min": 0.8,
      "max": 3
    }
  ],
  "signals": {
    "longEntry": "close < bb_lower(close, lb, k) and natr(14) > sma(natr(14), volLb) * volMult",
    "longExit": "close > sma(close, lb)",
    "shortEntry": "close > bb_upper(close, lb, k) and natr(14) > sma(natr(14), volLb) * volMult",
    "shortExit": "close < sma(close, lb)"
  },
  "sizing": {
    "mode": "equityPct",
    "value": 100
  },
  "risk": {
    "leverage": 1,
    "maxDailyLossPct": 6,
    "maxHoldBars": 36
  }
}