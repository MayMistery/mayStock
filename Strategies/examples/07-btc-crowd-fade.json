{
  "schema" : 1,
  "id" : "07-btc-crowd-fade",
  "name" : "BTC 逆散户仓位",
  "version" : "1.0.0",
  "author" : "MayStock examples",
  "notes" : "多空账户比 > 1 表示散户净多。经典的逆向思路是在人群极度一致时反向。警告：该接口 1D 周期只有 179 天、1H 只有 30 天历史，样本远不足以验证，此清单主要用于演示信号接入方式。",
  "market" : { "instId" : "BTC-USDT", "instType" : "SPOT", "bar" : "1D" },
  "data" : {
    "lsr"  : { "source" : "longShortRatio", "ccy" : "BTC" },
    "flow" : { "source" : "takerImbalance", "ccy" : "BTC", "instType" : "SPOT" }
  },
  "params" : [
    { "name" : "crowded", "default" : 1.4, "min" : 1.05, "max" : 2.5, "step" : 0.05, "label" : "拥挤阈值" },
    { "name" : "calm",    "default" : 1.1, "min" : 0.8,  "max" : 1.5, "step" : 0.05, "label" : "回落阈值" },
    { "name" : "trend",   "default" : 20,  "min" : 5,    "max" : 60,  "label" : "趋势过滤" }
  ],
  "signals" : {
    "longEntry" : "lsr < calm and flow > 0 and close > sma(close, trend)",
    "longExit"  : "lsr > crowded or close < sma(close, trend)"
  },
  "sizing" : { "mode" : "equityPct", "value" : 100 },
  "risk" : { "stopLossPct" : 6, "leverage" : 1, "cooldownBars" : 1, "minHoldBars" : 0 }
}
