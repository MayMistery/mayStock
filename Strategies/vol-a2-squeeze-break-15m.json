{
  "schema": 1,
  "id": "vol-a2-squeeze-break-15m",
  "name": "A2 布林挤压突破 · 15m",
  "notes": "15m 版挤压突破，为了拿到足够的样本量。",
  "market": {
    "instId": "BTC-USDT-SWAP",
    "instType": "SWAP",
    "bar": "15m"
  },
  "params": [
    {
      "name": "bbn",
      "default": 20,
      "min": 10,
      "max": 60
    },
    {
      "name": "wn",
      "default": 192,
      "min": 48,
      "max": 600
    },
    {
      "name": "sq",
      "default": 0.8,
      "min": 0.4,
      "max": 1.0
    },
    {
      "name": "brk",
      "default": 8,
      "min": 4,
      "max": 48
    },
    {
      "name": "exn",
      "default": 6,
      "min": 3,
      "max": 30
    }
  ],
  "signals": {
    "longEntry": "ref(bb_width(close, bbn, 2), 1) < sq * sma(bb_width(close, bbn, 2), wn) and close > ref(highest(high, brk), 1)",
    "longExit": "close < ref(lowest(low, exn), 1)",
    "shortEntry": "ref(bb_width(close, bbn, 2), 1) < sq * sma(bb_width(close, bbn, 2), wn) and close < ref(lowest(low, brk), 1)",
    "shortExit": "close > ref(highest(high, exn), 1)"
  },
  "sizing": {
    "mode": "equityPct",
    "value": 100
  },
  "risk": {
    "leverage": 1,
    "maxDailyLossPct": 6,
    "maxHoldBars": 32,
    "cooldownBars": 0
  }
}