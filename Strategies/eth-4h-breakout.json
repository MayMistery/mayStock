{
  "schema": 1,
  "id": "eth-4h-breakout",
  "name": "ETH 4H 通道突破",
  "version": "1.0.0",
  "author": "MayStock lab",
  "notes": "研究候选，走向前 4 折中 3 折盈利、效率比 0.95，是全空间里唯一接近站得住的配置；但样本外仅 10 笔交易，远低于 30 笔/参数 的统计下限，日均仅 0.050%。详见 docs/RESEARCH-BTC-ETH.md。",
  "market": {
    "instId": "ETH-USDT",
    "instType": "SPOT",
    "bar": "4H"
  },
  "params": [
    {
      "name": "entryLen",
      "default": 20,
      "min": 6,
      "max": 100,
      "label": "入场通道"
    },
    {
      "name": "exitLen",
      "default": 10,
      "min": 3,
      "max": 50,
      "label": "离场通道"
    }
  ],
  "signals": {
    "longEntry": "close > ref(highest(high, entryLen), 1)",
    "longExit": "close < ref(lowest(low, exitLen), 1)"
  },
  "sizing": {
    "mode": "equityPct",
    "value": 100
  },
  "risk": {
    "atrStop": {
      "period": 14,
      "mult": 2.5
    },
    "leverage": 1,
    "cooldownBars": 0,
    "minHoldBars": 0
  }
}